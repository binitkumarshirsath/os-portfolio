# Copy to .env.local and fill in. All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Primary model provider (Groq). Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Fallback model provider (Google Gemini). Create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Upstash Redis REST URL for rate limiting. Leave empty locally to skip limiting; required in production.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token, from the same database page as the URL.
UPSTASH_REDIS_REST_TOKEN=

# Random secret mixed into visitor IP hashes so Redis never holds raw IPs. Generate with: openssl rand -hex 32
IP_HASH_SALT=
